# =============================================================================
# LibreChat .env additions for the SEM trojan-screening setup.
# Copy the relevant lines into your LibreChat .env — this file is a template,
# never commit a real key.
# =============================================================================

# --- Claude access via your existing Open WebUI instance ---------------------
# Root URL of the instance, WITHOUT a trailing /api (librechat.yaml appends it).
OPENWEBUI_URL=http://webui.internal:3000

# Only needed if you switched librechat.yaml's `apiKey` from "user_provided"
# to "${OPENWEBUI_API_KEY}" — i.e. one shared service token for everyone.
# With "user_provided" (the default here) each analyst pastes their own token
# in the LibreChat UI instead, and nothing sensitive lives in this file.
# Create tokens in Open WebUI: Settings -> Account -> API Keys.
#OPENWEBUI_API_KEY=sk-replace-me

# --- where the detector's MCP service is listening ---------------------------
# Must match librechat.yaml's mcpServers.trojan-detector.url and the port
# published by run_detector_mcp.sh.
#TROJAN_MCP_URL=http://localhost:8130/mcp
